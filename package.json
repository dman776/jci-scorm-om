{
  "name": "scorm-observation-workbook-builder",
  "version": "1.1.0",
  "private": true,
  "description": "Author digital observation workbooks (ride-alongs, shadowing, field observations) and export them as self-contained SCORM 2004 4th Edition packages for Workday Learning.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node apps/server/index.js",
    "dev": "node apps/server/index.js",
    "build:template": "node scripts/build-template-xlsx.js",
    "export:demo": "node scripts/export-demo.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "playwright test tests/e2e"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "nanoid": "5.1.16"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3"
  }
}
